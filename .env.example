# ============================================================
# AI Shorts Factory — змінні середовища
# Скопіюйте цей файл у .env (в корені репозиторію) і заповніть.
# Локально web і worker читають .env з кореня репозиторію.
# На Railway змінні задаються в дашборді кожного сервісу.
# ============================================================

# --- База даних (PostgreSQL) ---
# Локально: встановіть PostgreSQL і створіть базу, або підніміть через Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=shorts postgres:16
# На Railway: додайте плагін PostgreSQL -> вкладка Variables -> скопіюйте DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shorts

# --- Redis (черга BullMQ) ---
# Локально: docker run -d -p 6379:6379 redis:7
# На Railway: додайте плагін Redis -> вкладка Variables -> скопіюйте REDIS_URL
REDIS_URL=redis://localhost:6379

# --- Anthropic API (генерація ідей, сценаріїв, описів) ---
# Де взяти: https://console.anthropic.com -> Settings -> API Keys -> Create Key
ANTHROPIC_API_KEY=

# --- ElevenLabs (озвучка українською з таймкодами по словах) ---
# Де взяти: https://elevenlabs.io -> вхід -> іконка профілю (внизу зліва) -> API Keys -> Create API Key
ELEVENLABS_API_KEY=
# ID голосу. Де взяти: https://elevenlabs.io/app/voice-library -> знайдіть голос з підтримкою
# української -> Add to my voices -> My Voices -> три крапки -> Copy Voice ID.
# За замовчуванням тут мультимовний голос; краще підібрати український.
ELEVENLABS_VOICE_ID=

# --- fal.ai (генерація зображень Flux) ---
# Де взяти: https://fal.ai -> вхід через GitHub/Google -> https://fal.ai/dashboard/keys -> Add key
FAL_KEY=

# --- Cloudflare R2 (сховище файлів, S3-сумісне) ---
# Де взяти: https://dash.cloudflare.com -> R2 Object Storage -> Create bucket (назву впишіть у R2_BUCKET)
# Потім: R2 -> Manage R2 API Tokens (праворуч угорі) -> Create API Token -> Permissions: Object Read & Write
# ACCOUNT_ID видно в URL дашборда або на головній сторінці R2 (праворуч, "Account ID")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shorts-factory

# --- Google OAuth (публікація на YouTube як Shorts) ---
# Покрокова інструкція створення OAuth-клієнта — у файлі SETUP.md, розділ "Google Cloud / YouTube".
# Коротко: https://console.cloud.google.com -> створити проєкт -> увімкнути "YouTube Data API v3"
# -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram (ручна публікація TikTok: бот шле відео + текст у ваш чат) ---
# TELEGRAM_BOT_TOKEN: у Telegram напишіть @BotFather -> /newbot -> отримаєте токен
# TELEGRAM_CHAT_ID: напишіть своєму боту будь-яке повідомлення, потім відкрийте
#   https://api.telegram.org/bot<ТОКЕН>/getUpdates і скопіюйте "chat":{"id": ...}
#   (або напишіть @userinfobot — він покаже ваш id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Адреса веб-застосунку (для OAuth-редіректу Google) ---
# Локально: http://localhost:3000
# На Railway: публічний домен сервісу web, наприклад https://web-production-xxxx.up.railway.app
APP_URL=http://localhost:3000
